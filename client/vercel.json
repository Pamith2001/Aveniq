{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://aveniq-backend.aveniq-cloudflare-backend.workers.dev/api/:path*"
    },
    {
      "source": "/ws",
      "destination": "https://aveniq-backend.aveniq-cloudflare-backend.workers.dev/ws"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
